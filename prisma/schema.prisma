// BUBER data model.
// Money is stored in agorot (integer, 1 ILS = 100 agorot).
// Instants are stored as UTC timestamps; recurring schedules are stored as
// minutes from local midnight in the business timezone (Asia/Jerusalem).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  BARBER
  HAIR_SALON
  HAIRSTYLIST
  BLOWOUT
  NAILS
  MAKEUP
  BROWS_LASHES
}

enum BusinessStatus {
  PENDING_REVIEW
  APPROVED
  SUSPENDED
}

enum MemberRole {
  OWNER
  STAFF
}

enum ServiceMode {
  FIXED        // fixed price, auto-confirmed
  CONSULTATION // pending until business proposes a price/time and customer accepts
}

enum AppointmentStatus {
  REQUESTED  // consultation request, does not hold a slot
  PROPOSED   // business proposed price + time, waiting for customer
  CONFIRMED
  COMPLETED
  CANCELLED
  DECLINED
  NO_SHOW
}

enum AppointmentSource {
  PROFILE
  REEL
  SEARCH
  MANUAL
}

enum ReelStatus {
  DRAFT
  PROCESSING
  PUBLISHED
  FAILED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportTarget {
  REEL
  BUSINESS
}

enum NotificationStatus {
  PENDING
  SENT    // accepted by a real provider
  LOGGED  // no provider configured: written to the development delivery log, NOT delivered
  FAILED
  CANCELLED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum AnalyticsType {
  REEL_VIEW
  PROFILE_VIEW
  BOOKING_START
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  name         String
  passwordHash String
  isAdmin      Boolean   @default(false)
  city         String?
  lat          Float?
  lng          Float?
  interests    Category[]
  onboardedAt  DateTime?
  createdAt    DateTime  @default(now())

  sessions      Session[]
  memberships   BusinessMember[]
  appointments  Appointment[]       @relation("CustomerAppointments")
  likes         Like[]
  savedReels    SavedReel[]
  savedBusinesses SavedBusiness[]
  collections   Collection[]
  follows       Follow[]
  reports       Report[]            @relation("Reporter")
  blocks        Block[]
  reviews       Review[]
  adminActions  AdminAction[]
  staffProfiles StaffMember[]
}

model Session {
  id         String   @id // sha256 of the cookie token
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       String   @default("customer") // "customer" | "business"
  businessId String?  // active business when mode = business
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Business {
  id                      String         @id @default(cuid())
  slug                    String         @unique
  name                    String
  tagline                 String?
  description             String         @default("")
  categories              Category[]
  city                    String
  address                 String         @default("")
  lat                     Float?
  lng                     Float?
  phone                   String?
  instagram               String?
  coverPath               String?
  avatarPath              String?
  status                  BusinessStatus @default(PENDING_REVIEW)
  verified                Boolean        @default(false) // only set by an admin after a real check
  isDemo                  Boolean        @default(false)
  timezone                String         @default("Asia/Jerusalem")
  cancellationHours       Int            @default(24)
  cancellationPolicy      String         @default("ביטול או שינוי ללא עלות עד 24 שעות לפני התור.")
  slotStepMinutes         Int            @default(15)
  minLeadMinutes          Int            @default(60)
  maxAdvanceDays          Int            @default(60)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  members      BusinessMember[]
  staff        StaffMember[]
  services     Service[]
  openingHours OpeningHours[]
  reels        Reel[]
  portfolio    PortfolioItem[]
  appointments Appointment[]
  followers    Follow[]
  savedBy      SavedBusiness[]
  reviews      Review[]
  events       AnalyticsEvent[]
  blockedCustomers BusinessBlock[]
  blockedBy    Block[]

  @@index([status, city])
}

model BusinessMember {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       MemberRole
  createdAt  DateTime   @default(now())

  @@unique([businessId, userId])
}

model OpeningHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday    Int      // 0 = Sunday ... 6 = Saturday
  openMin    Int
  closeMin   Int

  @@index([businessId])
}

model StaffMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?  // linked login for staff access
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  title      String   @default("")
  avatarPath String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  services     StaffService[]
  workingHours WorkingHours[]
  breaks       StaffBreak[]
  timeOff      TimeOff[]
  appointments Appointment[]
  reels        Reel[]

  @@index([businessId])
}

model Service {
  id           String      @id @default(cuid())
  businessId   String
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  description  String      @default("")
  category     Category
  styleTags    String[]
  mode         ServiceMode @default(FIXED)
  priceAgorot  Int         // FIXED: exact price. CONSULTATION: starting price.
  durationMin  Int
  bufferMin    Int         @default(0) // preparation/cleanup after the service
  active       Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  staff        StaffService[]
  appointments Appointment[]
  reels        Reel[]

  @@index([businessId])
}

model StaffService {
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model WorkingHours {
  id       String      @id @default(cuid())
  staffId  String
  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int

  @@index([staffId])
}

model StaffBreak {
  id       String      @id @default(cuid())
  staffId  String
  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int
  label    String      @default("הפסקה")

  @@index([staffId])
}

model TimeOff {
  id       String      @id @default(cuid())
  staffId  String
  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  reason   String      @default("")

  @@index([staffId, startsAt])
}

model Appointment {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      User?             @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: SetNull)
  // Manual (phone) bookings without an account
  guestName     String?
  guestPhone    String?
  staffId       String
  staff         StaffMember       @relation(fields: [staffId], references: [id], onDelete: Restrict)
  serviceId     String?
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  status        AppointmentStatus
  startsAt      DateTime
  endsAt        DateTime          // end of the service itself
  blockEndsAt   DateTime          // endsAt + buffer: the staff is busy until this instant

  // Agreement snapshot — later service edits never change these
  serviceName        String
  priceAgorot        Int
  priceIsFinal       Boolean
  durationMin        Int
  bufferMin          Int
  cancellationHours  Int
  cancellationPolicy String

  // Consultation proposal (business → customer)
  proposedStartsAt   DateTime?
  proposedPriceAgorot Int?
  proposedStaffId    String?
  proposedDurationMin Int?
  proposalNote       String?

  notes          String?
  businessNote   String?
  source         AppointmentSource @default(PROFILE)
  sourceReelId   String?
  sourceReel     Reel?             @relation("SourceReel", fields: [sourceReelId], references: [id], onDelete: SetNull)
  idempotencyKey String?
  createdById    String?
  cancelledAt    DateTime?
  cancelledBy    String?           // "customer" | "business" | "admin"
  cancelReason   String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  inspirations AppointmentInspiration[]
  events       AppointmentEvent[]
  payments     PaymentRecord[]
  review       Review?
  notifications Notification[]

  @@unique([customerId, idempotencyKey])
  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId, startsAt])
}

model AppointmentInspiration {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  reelId        String
  reel          Reel        @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, reelId])
}

model AppointmentEvent {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          String      // created, confirmed, proposed, accepted, rescheduled, cancelled, completed, no_show, declined
  actorId       String?
  data          Json?
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

model PaymentRecord {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amountAgorot  Int
  method        String      // "at_business" (cash/card at the counter). Future: "deposit", "refund"
  provider      String      @default("manual")
  externalRef   String?
  recordedById  String?
  createdAt     DateTime    @default(now())
}

model Reel {
  id              String     @id @default(cuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffId         String?
  staff           StaffMember? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  caption         String     @default("")
  tags            String[]
  category        Category
  status          ReelStatus @default(DRAFT)
  publishWhenReady Boolean   @default(false)
  originalPath    String?
  videoPath       String?    // H.264 MP4 rendition
  webmPath        String?    // VP9 WebM rendition (browsers without H.264)
  thumbPath       String?
  durationSec     Float?
  width           Int?
  height          Int?
  failureReason   String?
  isSample        Boolean    @default(false)
  rightsConfirmed Boolean    @default(false)
  hiddenByAdmin   Boolean    @default(false)
  hiddenReason    String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  likes        Like[]
  saves        SavedReel[]
  collectionItems CollectionItem[]
  inspirations AppointmentInspiration[]
  sourceOf     Appointment[] @relation("SourceReel")
  events       AnalyticsEvent[]

  @@index([status, publishedAt])
  @@index([businessId])
}

model PortfolioItem {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  imagePath  String
  caption    String   @default("")
  isSample   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Like {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, reelId])
}

model SavedReel {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, reelId])
}

model SavedBusiness {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, businessId])
}

model Collection {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  items     CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reelId       String
  reel         Reel       @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([collectionId, reelId])
}

model Follow {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, businessId])
}

// Customer hides a business (its reels and profile from feed/search)
model Block {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, businessId])
}

// Business blocks a customer from booking
model BusinessBlock {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime @default(now())

  @@id([businessId, userId])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  ReportTarget
  targetId    String
  reason      String
  details     String       @default("")
  status      ReportStatus @default(OPEN)
  resolvedById String?
  resolution  String?
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  @@index([status])
}

model Review {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating        Int
  text          String      @default("")
  isSample      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([businessId])
}

model AnalyticsEvent {
  id         String        @id @default(cuid())
  type       AnalyticsType
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reelId     String?
  reel       Reel?         @relation(fields: [reelId], references: [id], onDelete: SetNull)
  userId     String?
  visitorKey String?
  createdAt  DateTime      @default(now())

  @@index([businessId, type, createdAt])
  @@index([reelId, type])
}

model Notification {
  id            String             @id @default(cuid())
  appointmentId String?
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String?
  channel       String             // "email" | "sms"
  recipient     String
  template      String             // booking_confirmed, booking_requested, proposal, reminder_24h, cancelled, rescheduled
  subject       String
  body          String
  scheduledFor  DateTime
  status        NotificationStatus @default(PENDING)
  provider      String?            // "dev-log" when no credentials are configured
  attempts      Int                @default(0)
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  @@index([status, scheduledFor])
  @@index([appointmentId])
}

model Job {
  id        String    @id @default(cuid())
  type      String    // "process_reel" | "deliver_notifications" | "complete_past"
  payload   Json
  status    JobStatus @default(PENDING)
  runAt     DateTime  @default(now())
  attempts  Int       @default(0)
  lastError String?
  lockedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([status, runAt])
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  note       String   @default("")
  createdAt  DateTime @default(now())
}

model RateLimitHit {
  key       String
  windowStart DateTime
  count     Int      @default(1)

  @@id([key, windowStart])
}
