# --- Database (PostgreSQL 14+ with the btree_gist extension available) ---
DATABASE_URL="postgresql://buber:buber@localhost:5432/buber?schema=public"

# --- Media storage (local disk adapter). Production: replace with an S3-compatible adapter. ---
MEDIA_ROOT="./storage"
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"

# --- Background worker (reel processing, notification delivery) ---
# "true" (default) runs the worker inside the web process. Set "false" and run `npm run worker` separately in production.
RUN_WORKER_IN_APP="true"

# --- Development only ---
# One-click role login on /login. Ignored when NODE_ENV=production.
DEV_LOGIN_ENABLED="true"
# RATE_LIMIT_DISABLED="true"

# --- Production integrations (not required for local development) ---
# EMAIL_PROVIDER_API_KEY=""   # e.g. Resend/SendGrid/SMTP — implement in src/server/notifications.ts
# SMS_PROVIDER_API_KEY=""     # e.g. an Israeli SMS gateway
# PAYMENT_PROVIDER_KEY=""     # deposits/refunds — implement src/server/payments.ts
